# Copia in .env (o nei secret di GitHub Actions) e compila.
ANTHROPIC_API_KEY=
# Account Instagram professionale (Business o Creator) collegato a una Pagina Facebook
IG_USER_ID=
# Token di lunga durata con permessi: instagram_basic, instagram_content_publish, instagram_manage_insights, pages_show_list, pages_read_engagement, business_management
META_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0
# Pagina da osservare
SOURCE_USERNAME=technologybrief
# URL pubblico dove vengono caricate le immagini generate (Instagram le scarica da qui)
PUBLIC_IMAGE_BASE_URL=
# Firma mostrata sulle slide
BRAND_HANDLE=@bitquotidiano.it
